# Copy to studio/.env (gitignored). The Studio reads it on start.
# Either set an API key here, or run `ant auth login` once and leave it unset.
ANTHROPIC_API_KEY=
# Public origin of the site, used in social copy links.
SITE_URL=https://priyanshukumarsingh.vercel.app
# Port for the Studio UI (bound to 127.0.0.1 only).
STUDIO_PORT=8787
# Set to 1 to use canned AI responses, for trying the UI without spending tokens.
STUDIO_FAKE_AI=0
