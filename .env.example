# Copy to .env (gitignored). Blog Studio reads it on start.

# The blog to open when you run `blog-studio` without --site.
BLOG_STUDIO_SITE=../my-blog

# Claude credentials: an API key here, or run `ant auth login` once and leave it unset.
ANTHROPIC_API_KEY=

# Port for the Studio UI (bound to 127.0.0.1 only).
STUDIO_PORT=8787

# Set to 1 to use canned AI responses, for trying the UI without spending tokens.
STUDIO_FAKE_AI=0

# GitHub sign-in (in progress): an OAuth App with callback http://127.0.0.1:8787/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
