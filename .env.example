# Copy to .env (gitignored). Masthead reads it on start.

# local: one person, one blog on this machine. cloud: the hosted, multi-tenant service.
MASTHEAD_MODE=local

# Set to 1 to use canned AI responses, for trying the app without spending tokens.
STUDIO_FAKE_AI=0

# --- Local mode ---------------------------------------------------------------
# The blog to open when you run `blog-studio` with no arguments, relative to this folder.
BLOG_STUDIO_CONFIG=blogs/my-blog/blog-studio.toml
# Or, when the settings live inside the blog's own repository:
# BLOG_STUDIO_SITE=../my-blog
# Claude credentials: an API key here, or run `ant auth login` once and leave it unset.
ANTHROPIC_API_KEY=
# Port for the local app (bound to 127.0.0.1 only).
STUDIO_PORT=8787

# --- Hosted mode --------------------------------------------------------------
# The public origin. OAuth callbacks, Stripe return URLs and the host check use it.
MASTHEAD_BASE_URL=http://127.0.0.1:8787
# Postgres in production, e.g. postgresql+psycopg://user:pass@host:5432/masthead. SQLite if unset.
DATABASE_URL=
# At least 32 random characters. Encrypts each workspace's Anthropic key. Keep it stable.
MASTHEAD_SECRET_KEY=

# Sign-in: a GitHub OAuth App with callback <MASTHEAD_BASE_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Repository access: a GitHub App with Setup URL <MASTHEAD_BASE_URL>/github/setup
GITHUB_APP_ID=
GITHUB_APP_SLUG=masthead
GITHUB_APP_PRIVATE_KEY=

# Billing: prices are found by lookup key (team_monthly, team_yearly, business_monthly, business_yearly).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=0
